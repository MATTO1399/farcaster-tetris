# =========================================================
# Hardhat / Base
# =========================================================

# Base Sepolia RPC URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Mainnet RPC URL
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Deployer private key (0x付き)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# BaseScan API key (verifyで使う)
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# =========================================================
# FirstPlayNFT Deploy Params
# =========================================================

# Collection name / symbol
NFT_NAME=FARTETRIS First Play
NFT_SYMBOL=FFP

# owner は未指定なら deployer.address を使う
INITIAL_OWNER=0xYOUR_OWNER_ADDRESS

# 署名発行サーバー用の signer address
INITIAL_SIGNER=0xYOUR_SIGNER_ADDRESS

# tokenURI = BASE_TOKEN_URI + tokenId + ".json"
# 例: https://farcaster-tetris.vercel.app/api/metadata/first-play/
BASE_TOKEN_URI=https://your-domain.com/metadata/first-play/

# キャンペーン文字列。deploy時に keccak256 されて campaignId になる
CAMPAIGN_TEXT=FIRST_PLAY_V1

# 0 = 無制限
MAX_SUPPLY=0
